# Copy to .env and fill in. .env is gitignored — keep it that way.
# NOT required for phase 1 or phase 2 (both run without any API subscription).
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Only if you set an IP whitelist on the Kite app. Home broadband IPs are
# DYNAMIC -- auth.py warns when yours has moved, so a rotated IP reads as an
# ISP event and not a code bug. Leave unset if the whitelist is blank.
KITE_WHITELISTED_IP=
